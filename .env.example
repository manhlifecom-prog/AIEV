# Copy thành .env.local. Không commit file chứa secret.
OPENAI_API_KEY=

# Model roles tập trung. Có thể đổi trong Settings > Connections.
OPENAI_DIRECTOR_MODEL=gpt-5.5
OPENAI_FAST_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts

# local (mặc định, faster-whisper) | openai
TRANSCRIPTION_ENGINE=local

QUEUE_CONCURRENCY=
TUNNEL_DOMAIN=
SERVER_PORT=6869
# WEB_PORT=6868
# PYTHON_BIN=
AIEV_API_TOKEN=
