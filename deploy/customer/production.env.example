# Copy to .env.production on the server and restrict access to the file.
# Empty credentials keep paid rendering and top-ups disabled.
OPENAI_API_KEY=
CUSTOMER_SEPAY_WEBHOOK_KEY=
CUSTOMER_DIRECTOR_MODEL=gpt-5.5

# Starting values only; confirm commercial pricing before enabling payments.
CUSTOMER_TOKEN_PRICE_VND=1000
CUSTOMER_BASE_TOKENS=10
CUSTOMER_TOKENS_PER_MINUTE=20
CUSTOMER_MIN_FREE_BYTES=536870912
CUSTOMER_MAX_VIDEO_BYTES=0
CUSTOMER_MAX_VIDEO_SECONDS=0
CUSTOMER_TOKENS_PER_GIB=10
